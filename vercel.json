{
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm run build:vercel-function && pnpm --filter @workspace/ledgerline-expense run build",
  "outputDirectory": "artifacts/ledgerline-expense/dist/public",
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}